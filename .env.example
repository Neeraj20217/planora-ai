# Copy to .env.local. Set credentials locally; never commit .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Enables loopback development only. Hosted generation remains blocked.
AI_ENABLE_LOCAL_GENERATION=false
# Hosted release remains disabled. Do not copy production credentials into previews.
AI_ENABLE_HOSTED_GENERATION=false
AI_HOSTED_RELEASE_APPROVED=false
PLANORA_PRODUCTION_ORIGIN=
PLANORA_SECURITY_NAMESPACE=
PLANORA_IP_HASH_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
